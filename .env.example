# SMTP Email Configuration for Vercel Serverless Function
# Copy these variables and paste them into your Vercel Dashboard (Project Settings -> Environment Variables)
# Or create a '.env.local' file in the project root for local testing.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_TO=your_receiving_email@example.com
